<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Training.Workshop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn: sceny m2 (bramka kompilatora, bramka jakości) i testy kompilujące kod w pamięci -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Training.Workshop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- m2/s04: próbki domeny dla bramki jakości - bramka kompiluje je w pamięci, projekt nie -->
    <Compile Remove="M2/S04QualityGate/Sample/**/*.cs" />
    <None Include="M2/S04QualityGate/Sample/**/*.cs" />
  </ItemGroup>

</Project>
