{
    "name": "pl-training/refactoring-legacy-php",
    "description": "Refaktoryzacja do wzorców - ćwiczenia utrwalające CineLegacy w PHP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
